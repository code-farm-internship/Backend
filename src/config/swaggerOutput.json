                            "$ref": "#/definitions/User"
                        }
                    },
                    "400": {
                        "description": "Dữ liệu đầu vào không hợp lệ"
                    },
                    "409": {
                        "description": "User đã tồn tại"
                    },
                    "500": {
                        "description": "Lỗi máy chủ nội bộ"
                    }
                }
            }
        },
        "/auth/login": {
            "post": {
                "description": "Xác thực user và trả về token JWT.",
                "consumes": ["application/json"],
                "parameters": [
                    {
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/UserLoginInput"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Đăng nhập thành công",
                        "schema": {
                            "$ref": "#/definitions/AuthResponse"
                        }
                    },
                    "401": {
                        "description": "Thông tin đăng nhập không hợp lệ"
                    },
                    "500": {
                        "description": "Lỗi máy chủ nội bộ"
                    }
                }
            }
        },
        "/auth/refresh": {
            "get": {
                "description": "Làm mới token JWT bằng refresh token hợp lệ.",
                "parameters": [{ "$ref": "#/parameters/AuthorizationHeader" }],
                "responses": {
                    "200": {
                        "description": "Token được làm mới thành công",
                        "schema": {
                            "$ref": "#/definitions/AuthResponse"
                        }
                    },
                    "401": {
                        "description": "Refresh token không hợp lệ hoặc đã hết hạn"
                    },
                    "500": {
                        "description": "Lỗi máy chủ nội bộ"
                    }
                }
            }
        },
        "/auth/verify-email": {
            "post": {
                "description": "Xác minh email của người dùng bằng token xác minh.",
                "consumes": ["application/json"],
                "parameters": [
                    {
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/VerifyEmailInput"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Email được xác minh thành công"
                    },
                    "400": {
                        "description": "Token không hợp lệ"
                    },
                    "500": {
                        "description": "Lỗi máy chủ nội bộ"
                    }
                }
            }
        },
        "/auth/resend-verification": {
            "post": {
                "description": "Gửi lại email xác minh cho user.",
                "consumes": ["application/json"],
                "parameters": [
                    {
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object",
                            "properties": {
                                "email": {
                                    "type": "string",
                                    "format": "email"
                                }
                            },
                            "required": ["email"]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Email xác minh được gửi lại thành công"
                    },
                    "404": {
                        "description": "Không tìm thấy user"
                    },
                    "500": {
                        "description": "Lỗi máy chủ nội bộ"
                    }
                }
            }
        },
