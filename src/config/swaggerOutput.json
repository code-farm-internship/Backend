{
    "swagger": "2.0",
    "info": {
        "title": "E-commerce API",
        "description": "Tài liệu API cho hệ thống E-commerce, cung cấp các endpoint để quản lý danh mục, xác thực, nhà cung cấp, định dạng, sản phẩm, giỏ hàng và chiết khấu.",
        "version": "1.0.0"
    },
    "host": "localhost:8000",
    "basePath": "/api/v1",
    "schemes": ["http"],
    "produces": ["application/json"],
    "parameters": {
        "IdPath": {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Id duy nhất"
        },
        "ProductIdPath": {
            "name": "productId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Id duy nhất của sản phẩm"
        },
        "VariantIdPath": {
            "name": "variantId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Id duy nhất của biến thể sản phẩm"
        },
        "AuthorizationHeader": {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "Token Bearer để xác thực"
        }
    },
    "paths": {
        "/categories/all": {
            "get": {
                "description": "Lấy danh sách tất cả các category trong hệ thống.",
                "responses": {
                    "200": {
                        "description": "Danh sách các category.",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/Category"
                            }
                        }
                    },
                    "500": {
                        "description": "Lỗi máy chủ nội bộ"
                    }
                }
            }
        },

        "/categories/{id}": {
            "get": {
                "description": "Lấy thông tin chi tiết của một category theo ID.",
                "parameters": [{ "$ref": "#/parameters/IdPath" }],
                "responses": {
                    "200": {
                        "description": "Thông tin chi tiết category.",
                        "schema": {
                            "$ref": "#/definitions/Category"
                        }
                    },
                    "404": {
                        "description": "Không tìm thấy category."
                    },
                    "500": {
                        "description": "Lỗi máy chủ nội bộ."
                    }
                }
            }
        },
        "/categories/create": {
            "post": {
                "description": "Tạo một category mới. Yêu cầu verify admin",
                "consumes": ["application/json"],
                "parameters": [
                    {
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/CategoryInput"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "CategoryI được tạo thành công",
                        "schema": {
                            "$ref": "#/definitions/Category"
                        }
                    },
                    "400": {
                        "description": "Dữ liệu đầu vào không hợp lệ"
                    },
                    "401": {
                        "description": "Không được phép"
                    },
                    "500": {
                        "description": "Lỗi máy chủ nội bộ"
                    }
                }
            }
        },
        "/categories/update/{id}": {
            "put": {
                "description": "Cập nhật một category hiện có theo id. Yêu cầu verify admin.",
                "consumes": ["application/json"],
                "parameters": [
                    { "$ref": "#/parameters/IdPath" },
                    {
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/CategoryInput"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Danh mục được cập nhật thành công",
                        "schema": {
                            "$ref": "#/definitions/Category"
                        }
                    },
                    "400": {
                        "description": "Dữ liệu đầu vào không hợp lệ"
                    },
                    "401": {
                        "description": "Không được phép"
                    },
                    "404": {
                        "description": "Không tìm thấy category"
                    },
                    "500": {
                        "description": "Lỗi máy chủ nội bộ"
                    }
                }
            }
        },
        "/categories/delete/{id}": {
            "delete": {
                "description": "Xóa một category theo ID. Yêu cầu verify admin.",
                "parameters": [{ "$ref": "#/parameters/IdPath" }],
                "responses": {
                    "204": {
                        "description": "Category được xóa thành công."
                    },
                    "401": {
                        "description": "Không được phép xóa."
                    },
                    "404": {
                        "description": "Không tìm thấy category."
                    },
                    "500": {
                        "description": "Lỗi máy chủ nội bộ."
                    }
                }
            }
        },
